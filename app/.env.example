# Copy to .env. Only variables prefixed EXPO_PUBLIC_ are visible to the app.

# Where the API lives. Defaults to http://localhost:3000 when unset.
#  - web and iOS simulator: http://localhost:3000
#  - Android emulator:      http://10.0.2.2:3000
#  - a physical phone:      http://<your-computer's-LAN-IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
