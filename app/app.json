{
  "expo": {
    "name": "Your Person",
    "slug": "your-person",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.juettner.yourperson"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#CFE3F7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.juettner.yourperson"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "scheme": "yourperson",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#CFE3F7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#1A1830"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your Person uses your location only to fill in the city your person lives in. Only the city name is saved."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#CFE3F7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
