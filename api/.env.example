# Copy to .env and adjust. Nothing here is required to run locally.

# Port the API listens on.
PORT=3000

# Leave unset to use in-memory storage (data lost on restart).
# Set to use MongoDB, e.g. a local container:  docker run -d -p 27017:27017 mongo:8
# MONGODB_URI=mongodb://localhost:27017/your-person

# Comma-separated list of allowed browser origins. Unset = allow any (fine for dev).
# CORS_ORIGIN=http://localhost:8081

# --- AI question engine (optional) ---
# When set, the API writes personalized questions per profile with Claude and
# mixes them into the deck. Leave unset to run on the curated bank only.
# ANTHROPIC_API_KEY=sk-ant-...
# Model for generation. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
# Let the engine web-search for timely local facts (games, events, openings)
# before writing questions. Costs more per refresh; off by default.
# AI_RESEARCH=true

# Requests per minute per client IP before the API answers 429. Default 60.
# RATE_LIMIT_PER_MINUTE=60
