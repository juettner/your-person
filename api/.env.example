# Copy to .env and adjust. Nothing here is required to run locally.

# Port the API listens on.
PORT=3000

# Leave unset to use in-memory storage (data lost on restart).
# Set to use MongoDB, e.g. a local container:  docker run -d -p 27017:27017 mongo:8
# MONGODB_URI=mongodb://localhost:27017/your-person

# Comma-separated list of allowed browser origins. Unset = allow any (fine for dev).
# CORS_ORIGIN=http://localhost:8081
